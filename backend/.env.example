# Reddit API (optional — https://www.reddit.com/prefs/apps)
# Without these, the backend uses Reddit public search (.json) for live posts.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trendwatch-ai/1.0 by YOUR_REDDIT_USERNAME

# Optional: OpenAI-compatible API for LLM reports and LLM-as-judge
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
