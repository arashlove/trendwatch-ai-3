# --- Option A: OpenAI direct ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Option B: OpenRouter (free/paid models) ---
OPENAI_API_KEY=sk-or-your-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-oss-120b:free
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=TrendWatch AI
# OPENAI_REASONING=true

OPENAI_TEMPERATURE=0.3

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trendwatch-ai/1.0
